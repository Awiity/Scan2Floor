# Matterport In3D — šablona .env (zkopírujte jako .env a doplňte klíč)
# SDK application key — vázaný na doménu localhost (jiné originy = licence)
matterport_api_key=<váš-application-key>

# volitelně:
# MP_MODEL_ID=yQPhyaCwigp        # prostor (default yQPhyaCwigp)
# MP_MERGE_RADIUS=...           # poloměr clusteringu per kategorie
# MP_REGISTRY_URL=http://<server>:8019  # centrální registr — auto synchronizace
#   (v rámci téhož compose stacku: http://registry:8019 — service name, ne localhost)
